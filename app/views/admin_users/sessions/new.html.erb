<!DOCTYPE html>
<html lang="en">
<head>
  <title>Sign in — Cashonrails Admin</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-[#f4f4f4] min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm">
    <div class="flex items-center justify-center gap-2 mb-8">
      <div class="w-9 h-9 bg-[#0ca376] rounded-xl flex items-center justify-center">
        <span class="text-white text-base font-bold">C</span>
      </div>
      <span class="text-[#4e4e4e] font-semibold text-lg tracking-tight">Cashonrails</span>
    </div>

    <div class="bg-white rounded-[20px] border border-[#ebebeb] p-8 shadow-sm">
      <h1 class="text-xl font-semibold text-[#4e4e4e] mb-1 tracking-tight">Admin Sign In</h1>
      <p class="text-sm text-[#919191] mb-6">Access the compliance dashboard</p>

      <% if flash[:alert] %>
        <div class="bg-red-50 border border-red-100 text-red-700 text-sm px-4 py-3 rounded-[12px] mb-4">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, "Email", class: "block text-xs font-medium text-[#6f6e73] mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full px-4 py-2.5 border border-[#ebebeb] rounded-[12px] text-sm text-[#4e4e4e] placeholder-[#919191] focus:outline-none focus:border-[#0ca376] focus:ring-1 focus:ring-[#0ca376] transition-colors bg-[#fafafa]",
                placeholder: "admin@cashonrails.com" %>
        </div>
        <div>
          <%= f.label :password, "Password", class: "block text-xs font-medium text-[#6f6e73] mb-1.5" %>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full px-4 py-2.5 border border-[#ebebeb] rounded-[12px] text-sm text-[#4e4e4e] placeholder-[#919191] focus:outline-none focus:border-[#0ca376] focus:ring-1 focus:ring-[#0ca376] transition-colors bg-[#fafafa]",
                placeholder: "••••••••" %>
        </div>
        <%= f.submit "Sign in",
              class: "w-full py-2.5 bg-[#0ca376] hover:bg-[#0a8f67] text-white text-sm font-medium rounded-[12px] transition-colors cursor-pointer mt-2" %>
      <% end %>
    </div>
  </div>
</body>
</html>
