<% errors ||= [] %>
<% verification ||= nil %>

<%= form_with url: verify_admin_merchant_verify_identity_path(merchant),
              method: :post,
              data: { turbo_stream: true, controller: "verify-identity", action: "turbo:submit-start->verify-identity#onSubmit turbo:submit-end->verify-identity#onSubmitEnd" },
              class: "space-y-4" do |f| %>

  <% if errors.any? %>
    <div class="bg-red-50 border border-red-100 text-red-700 text-sm px-4 py-3 rounded-[12px]">
      <%= errors.join(", ") %>
    </div>
  <% end %>

  <div class="flex items-start gap-3">
    <%# ID Type Segmented Control %>
    <div class="shrink-0">
      <label class="block text-xs text-[#919191] mb-1.5 font-medium">ID Type</label>
      <div class="flex items-center bg-[#f4f4f4] rounded-[12px] p-0.5 gap-0.5"
           data-controller="segmented-control"
           data-verify-identity-target="idTypeControl">
        <% %w[BVN NIN].each do |type| %>
          <label class="relative cursor-pointer">
            <input type="radio" name="id_type" value="<%= type.downcase %>"
                   class="sr-only peer"
                   <%= "checked" if type == "BVN" %>>
            <span class="block px-5 py-2 rounded-[10px] text-sm font-medium text-[#919191] peer-checked:bg-white peer-checked:text-[#4e4e4e] peer-checked:shadow-sm transition-all select-none">
              <%= type %>
            </span>
          </label>
        <% end %>
      </div>
    </div>

    <%# ID Number Input %>
    <div class="flex-1">
      <label class="block text-xs text-[#919191] mb-1.5 font-medium">
        <span data-verify-identity-target="idTypeLabel">BVN</span> Number
      </label>
      <%= f.text_field :id_number,
            placeholder: "Enter 11-digit number",
            maxlength: 11,
            inputmode: "numeric",
            pattern: "\\d{11}",
            required: true,
            class: "w-full px-4 py-2.5 border border-[#ebebeb] rounded-[12px] text-sm text-[#4e4e4e] placeholder-[#919191] focus:outline-none focus:border-[#0ca376] focus:ring-1 focus:ring-[#0ca376] transition-colors bg-[#fafafa] font-mono tracking-wider" %>
      <p class="text-xs text-[#919191] mt-1">Must be exactly 11 digits</p>
    </div>

    <%# Verify Button %>
    <div class="shrink-0 pt-6">
      <%= f.submit "Verify",
            class: "px-6 py-2.5 bg-[#0ca376] hover:bg-[#0a8f67] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-medium rounded-[12px] transition-colors cursor-pointer flex items-center gap-2",
            data: { verify_identity_target: "submitBtn" } %>
    </div>
  </div>

  <p class="text-xs text-[#919191] flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 text-[#0ca376]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    Results will appear in a one-time modal. The data is cleared when the modal is closed and cannot be reopened without a new lookup.
  </p>
<% end %>
